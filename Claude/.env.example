# Copy this file to .env and fill in your keys. .env is git-ignored.

# backend "kku" (default): keys issued at https://gen.ai.kku.ac.th
# One key:
KKU_API_KEY=your_kku_api_key_here
# Several keys (each has its own daily quota; the pipeline rotates and retires exhausted ones).
# Use either form, or both - duplicates are ignored:
# KKU_API_KEYS=key_one,key_two,key_three
# KKU_API_KEY_2=second_key
# KKU_API_KEY_3=third_key

# backend "api" (optional): Anthropic API key
ANTHROPIC_API_KEY=your_api_key_here
